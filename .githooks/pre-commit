#!/usr/bin/env bash
# Block commits on main, frozen-spec edits, and obvious secrets.
branch=$(git branch --show-current)
if [[ "$branch" == "main" ]]; then echo "pre-commit: do not commit on main; use a type/slug branch" >&2; exit 1; fi

current=$(ls -1 spec 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
while read -r status f; do
  if [[ "$f" =~ ^spec/([0-9]+\.[0-9]+\.[0-9]+)/ && "${BASH_REMATCH[1]}" != "$current" && "$status" != "A" ]]; then
    echo "pre-commit: spec/${BASH_REMATCH[1]} is frozen; edit spec/$current or bump" >&2; exit 1
  fi
done < <(git diff --cached --name-status | awk '{print $1, $2}')

if git diff --cached -U0 | grep -E '^\+.*(AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)' >/dev/null; then
  echo "pre-commit: possible secret in staged changes" >&2; exit 1
fi
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)|graphify-out' >/dev/null; then
  echo "pre-commit: .env or graphify files must not be committed" >&2; exit 1
fi
